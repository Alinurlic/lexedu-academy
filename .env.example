# ===== LexEdu Academy — переменные окружения =====
# Без них приложение работает в локальном режиме (LocalStorage, без регистрации, Lexi в демо-режиме).

# --- Клиент (попадают в сборку, это публичные значения) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Необязательно: Cloudflare Turnstile (защита регистрации от ботов). Секрет задаётся в Supabase → Auth → Attack Protection.
VITE_TURNSTILE_SITE_KEY=
# Необязательно: свой адрес ИИ-функции (по умолчанию /api/lexi на том же домене)
VITE_LEXI_API_URL=

# --- Сервер (Vercel Function api/lexi.ts). НИКОГДА не добавляйте префикс VITE_ к ключу ИИ ---
# Нужен ОДИН ключ ИИ. Если заданы оба, используется Claude.
# Claude (платный, лучшее качество): console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini (есть бесплатный тариф, без карты): aistudio.google.com → Get API key
GEMINI_API_KEY=
# Необязательно: модель Gemini (по умолчанию gemini-flash-latest)
GEMINI_MODEL=
# Только для сервера: общий кэш подробных разборов (Supabase → Project Settings → API Keys → service_role / secret).
# Тип Secret в Vercel, БЕЗ префикса VITE_ — ключ даёт полный доступ к базе и не должен попасть в браузер.
SUPABASE_SERVICE_ROLE_KEY=
# Необязательно (по умолчанию берутся VITE_SUPABASE_*)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Запросов к ИИ на пользователя в сутки
AI_DAILY_LIMIT=60
# Модель Claude (по умолчанию claude-opus-5-5)
LEXI_MODEL=
# Только для локальной разработки: разрешить ИИ без аккаунтов
# AI_ALLOW_ANONYMOUS=1
